{
  "manifest_version": 3,
  "name": "VPeeN Bridge",
  "version": "1.0.0",
  "description": "One-click Chrome proxy switch for the VPeeN local SOCKS5 tunnel. Routes the whole browser through VPeeN while it is connected.",
  "permissions": ["proxy", "storage"],
  "minimum_chrome_version": "108",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VPeeN Bridge"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
